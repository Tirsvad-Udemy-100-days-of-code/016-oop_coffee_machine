# Doxygen configuration for the coffee machine (Python source with Doxygen comments).
# Build with: doxygen Doxyfile   (output goes to docs/doxygen/, which is ignored by git)
PROJECT_NAME           = "OOP Coffee Machine"
PROJECT_BRIEF          = "Udemy 100 Days of Code: object-oriented coffee machine"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = src README.md
USE_MDFILE_AS_MAINPAGE = README.md
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
